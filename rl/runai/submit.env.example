# rl/runai/submit.env.example
# =============================================================================
# Copy to submit.env and fill in. submit.env is gitignored (it holds API keys).
#
#   cp rl/runai/submit.env.example rl/runai/submit.env
#   $EDITOR rl/runai/submit.env
#
# Everything here is a shell variable sourced by workloads.sh. Only the marked
# REQUIRED must change; the rest have working defaults.
# =============================================================================

# --- REQUIRED: cluster identity ---------------------------------------------
# Your Run:ai project name (`runai list projects` shows them).
RUNAI_PROJECT=CHANGE-ME

# The Kubernetes namespace backing that project. On most Run:ai installs it is
# "runai-<project>". Verify with: kubectl get ns | grep <project>
K8S_NAMESPACE=runai-CHANGE-ME

# Container registry the CLUSTER can pull from. On EPFL RCP this is
# ic-registry.epfl.ch/<project>, e.g. ic-registry.epfl.ch/mlbio -- check with
# `docker login ic-registry.epfl.ch` and your project's registry namespace.
# Only needed if you build images (rl/runai/build.sh); unused in the default
# ENV_MODE=scratch / TRAIN_MODE=ngc setup, which builds nothing.
REGISTRY=ic-registry.epfl.ch/CHANGE-ME

# --- REQUIRED: the judge ----------------------------------------------------
# The rubric judge is claude-sonnet-4-6 (matching server.yaml), so this is the
# key that actually gets used. Without it every episode scores 0.0 with no judge
# call -- which looks exactly like a model that cannot do the task.
ANTHROPIC_API_KEY=

# --- secrets: optional ------------------------------------------------------
HF_TOKEN=                 # model + dataset downloads
WANDB_API_KEY=            # training curves; logging is disabled if unset
OPENAI_API_KEY=           # only if you switch rubric_model to an OpenAI model
OPENROUTER_API_KEY=       # only if you switch rubric_model to OpenRouter

# Shared secret between the trainer and the env server. Must match `api_key` in
# rl/runai/server.train.yaml (which reads it from this env var by name).
HYPOTEST_API_KEY=hypotest-secret

# --- images -----------------------------------------------------------------
# Defaults derive from REGISTRY; override only if your tags differ.
# ENV_IMAGE=${REGISTRY}/${IMAGE_PREFIX}hypotest-env:latest
# TRAIN_IMAGE=${REGISTRY}/${IMAGE_PREFIX}hypotest-grpo:latest

# --- resources --------------------------------------------------------------
# GPUs for the `train` stage (Qwen3.6-35B-A3B). The checkpoint is 71.9 GB bf16
# and two copies must be resident (FSDP2 training shard + vLLM generation
# shard), so 2 GPUs leaves ~8 GB/GPU and will OOM. See docs/rl_context.md.
# The `tiny` stage overrides this to 1 regardless.
GPUS=4

TRAIN_CPU=32
TRAIN_MEM=384G

# The env pod runs N concurrent Jupyter kernels, one per in-flight rollout.
# 8 CPU / 64G is sized for the 2x2 test; raise both before scaling the batch.
ENV_CPU=8
ENV_MEM=64G

# Episode length cap. Every step becomes tokens inside
# policy.max_total_sequence_length, so this and the config's 16384 move together.
AGENT_MAX_STEPS=10

# --- storage ----------------------------------------------------------------
# One PVC, which your namespace already has: mlbio-scratch (100Ti RWX).
#
# It is the SAME filesystem as /mlbio_scratch on the host
# (nas3.rcp.epfl.ch:/ic_u1183_mlbio_scratch), so the capsules, the HF cache and
# the repo are already visible to the cluster. Nothing needs staging:
#
#   /mlbio_scratch/wangsaja/hypotest/capsules/hypotest   14 GB, already there
#   /mlbio_scratch/wangsaja/hf_cache                     4.3 GB, already there
#
# Mounting it at the same path inside the pod means host and cluster paths are
# identical, so anything you inspect on the host is what the pod actually read.
SCRATCH_PVC=mlbio-scratch
SCRATCH_MOUNT=/mlbio_scratch

# Where the env server writes finished episodes + score_info.json. Under the
# scratch mount so results survive the pod and you can read them from the host.
SAVE_DIR=/mlbio_scratch/wangsaja/hypotest/rl/results

# HF checkpoint cache. Reuses the existing one -- the 35B is 72 GB, so do not
# point this somewhere ephemeral.
HF_HOME=/mlbio_scratch/wangsaja/hf_cache

# NOTE: work_dir is deliberately NOT on this PVC. It is per-rollout scratch and
# dataset_server.py:128 copytree's a full capsule into it for every episode --
# the hottest path in the system, and NFS is the worst possible place for it.
# workloads.sh gives the env pod a node-local emptyDir instead.

# --- job names --------------------------------------------------------------
# ENV_JOB=hypotest-env
# TRAIN_JOB=hypotest-grpo
