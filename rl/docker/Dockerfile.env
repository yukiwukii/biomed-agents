# rl/docker/Dockerfile.env
# =============================================================================
# The hypotest dataset-server image (Workload A).
#
# Build the base first — this is the repo-root Dockerfile, unchanged:
#     make image                       # -> interpreter-env:latest
#     docker build -f rl/docker/Dockerfile.env -t hypotest-env:latest .
#
# WHY A SEPARATE IMAGE, AND WHY NOT use_docker: true
# --------------------------------------------------
# The repo-root Dockerfile builds the *kernel sandbox* image: its CMD is
# kernel_server.py, meant to be launched per-rollout by aiodocker when
# `use_docker: true`. That backend needs a Docker socket inside the pod, which
# Run:ai does not give you.
#
# So we invert it: the interpreter image becomes the *pod* image, and the
# dataset server runs inside it in plain local-kernel mode (use_docker: false,
# use_enroot: false). Isolation comes from the Kubernetes pod boundary rather
# than from a nested container. Each rollout still gets its own kernel
# subprocess and its own work_dir, exactly as it does on your workstation today.
#
# THE TWO PYTHON ENVIRONMENTS ARE DELIBERATE
# ------------------------------------------
# /app/kernel_env  conda, py3.12, the bioinformatics stack. Agent code runs here
#                  and agent `!pip install`s land in <work_dir>/pydeps.
# /app/hypotest/.venv  uv, py3.13, the orchestration venv (aviary, ldp, litellm).
#
# Keeping them apart is docs/patches.md Patch 22 — collapsing them lets agent
# code corrupt the server's own interpreter. Do not "simplify" this.
# =============================================================================

# Built from the repo-root Dockerfile. On x86_64 that Dockerfile already works
# as-is: its PATCH 1 (Miniconda aarch64) has been reverted to Linux-x86_64.
# On x86_64 only PATCH 6 (chemistry packages) is worth restoring; done below.
ARG BASE_IMAGE=interpreter-env:latest
FROM ${BASE_IMAGE}

# ---------------------------------------------------------------------------
# Optional, x86_64 only: restore the chemistry packages that PATCH 6 disabled.
# chempy's dependency pyodesys has no linux-aarch64 conda build, which is the
# only reason they were dropped. They install cleanly on x86_64 and the agent's
# capability prompt (prompts.SOFTWARE_STACK_CAPABILITIES) is more accurate with
# them present. Set to 0 to skip.
# ---------------------------------------------------------------------------
ARG INSTALL_CHEMISTRY=1
RUN if [ "${INSTALL_CHEMISTRY}" = "1" ]; then \
        mamba install -p /app/kernel_env -c conda-forge -y \
            rdkit=2025.09.2 \
            pubchempy=1.0.5 \
            chempy=0.10.1 && \
        mamba clean --all -y ; \
    fi

# ---------------------------------------------------------------------------
# Orchestration venv. uv is pinned by digest-free tag deliberately: the lock
# file (uv.lock) is what pins the actual dependency set.
# ---------------------------------------------------------------------------
COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /uvx /usr/local/bin/

WORKDIR /app/hypotest

# Dependency layer first so source edits don't invalidate the (slow) resolve.
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project

COPY src/ ./src/
COPY scripts/ ./scripts/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen

# ---------------------------------------------------------------------------
# Runtime configuration
# ---------------------------------------------------------------------------
# Points env/config.py:15 and interpreter.py:255 at the baked conda env, so the
# Jupyter kernel runs on /app/kernel_env/bin/python with the matching
# site-packages. Without this the kernel would launch under the 3.13 orchestration
# venv and fail to import numpy (docs/patches.md Patch 7).
ENV KERNEL_ENV_PATH=/app/kernel_env
ENV PATH="/app/hypotest/.venv/bin:${PATH}"
ENV PYTHONUNBUFFERED=1

# Local kernel backend — see the header. Overridable at deploy time.
ENV USE_DOCKER=false
ENV DEPLOYMENT_PROFILE=standard
# GRPO episodes should be much shorter than eval episodes; every step becomes
# tokens inside policy.max_total_sequence_length. Overridden by the workload spec.
ENV AGENT_MAX_STEPS=20

# capsule_dir, work_dir, save_dir and the config itself are mounted at runtime
# (see rl/runai/workloads.sh) rather than baked in — capsules are large and
# change independently of the code.
VOLUME ["/data/capsules", "/data/work", "/data/results"]

EXPOSE 8008

# server.yaml is mounted at /config/server.yaml by the workload spec.
CMD ["python", "src/hypotest/dataset_server.py", "/config/server.yaml"]
