# Copy to .env and fill in.
#
# litellm calls load_dotenv() when it is imported, so a .env in the CURRENT
# WORKING DIRECTORY is picked up automatically -- run commands from the repo
# root. If you run from elsewhere, export the variables yourself:
#   set -a && source /path/to/.env && set +a

# ── Judge / rubric model ─────────────────────────────────────────────────────
# REQUIRED. The judge is an LLM, and a missing key does NOT raise -- every
# episode simply scores 0.0, which looks exactly like a model that cannot do the
# task. If your scores are all zero, check this first.
# Needed for the default rubric_model (claude-sonnet-4-6) in the server config.
ANTHROPIC_API_KEY=

# Needed only if you point rubric_model at an OpenAI model, and by the graded
# rollout test in tests/test_interpreter_env.py.
OPENAI_API_KEY=

# Optional, for the openrouter/* and gemini/* entries in the example model_list.
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ── Dataset ──────────────────────────────────────────────────────────────────
# Needed to load the HuggingFace dataset and to download capsules.
HF_TOKEN=

# ── Environment behaviour ────────────────────────────────────────────────────
# Max agent steps per episode. NOTE for forking: replayed steps count against
# this budget, so a fork at step 20 with AGENT_MAX_STEPS=50 gets 30 steps to
# generate. A fork with no room left is skipped with reason "no_room".
AGENT_MAX_STEPS=30

# Absolute path to the conda env the Jupyter kernel runs in. Agents execute
# there, not in this repo's .venv, so an agent cannot break your tooling.
# Unset is fine: execution falls back to the ambient kernel.
KERNEL_ENV_PATH=

# Shared secret between dataset_server and benchmark_agent. Must match the
# api_key in BOTH your server config and your benchmark config. The server binds
# 0.0.0.0, so change this from the example value on any shared machine.
HYPOTEST_API_KEY=change-me
